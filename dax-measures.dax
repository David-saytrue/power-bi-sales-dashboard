// Paste one measure at a time: Data → Sales → New measure.
// Measure names must differ from column names (Power BI rule).

Total Revenue = SUM('Sales'[Revenue])

Total Profit = SUM('Sales'[Profit])

Logistics Cost = SUM('Sales'[ShippingCost])

Profitability = DIVIDE([Total Profit], [Total Revenue], 0)
// After create: Measure tools → Format → Percentage

Active Customers = DISTINCTCOUNT('Sales'[Customer])

Avg Order Value = DIVIDE([Total Revenue], DISTINCTCOUNT('Sales'[Order_ID]), 0)

Loss Making Orders =
CALCULATE(
    DISTINCTCOUNT('Sales'[Order_ID]),
    'Sales'[Profit] < 0
)
